          "parameters": {
            "level": {
              "type": "integer",
              "description": "0-100",
              "required": false
            }
          }
        },
        {
          "name": "no_tool_needed",
          "description": "Sentinel — no tool applies.",
          "parameters": {}
        }
      ]
      
