# name: test_build_user_prompt_classification
  '''
  [Task type] classification
  
  [Canonical schema]
  All keys: ['label', 'text']
  Required: ['label', 'text']
  
  [Sample rows from upload (first 2)]
  [
    {
      "text1": "I want a refund",
      "answer": "billing"
    },
    {
      "text1": "App crashes",
      "answer": "technical"
    }
  ]
  
  [Output Instructions]
  1. ONLY rename keys; do NOT alter values.
  2. If a key already matches a canonical key, OMIT it from the mapping.
  3. If a key cannot be confidently mapped, OMIT it (rows with unmapped required keys will be dropped).
  4. Output ONLY a JSON object: {"field_mapping": {"old_key": "new_key", ...}}
  
  '''
# ---
# name: test_build_user_prompt_tool_calling
  '''
  [Task type] tool_calling
  
  [Canonical schema]
  All keys: ['answer', 'question']
  Required: ['answer', 'question']
  
  [Sample rows from upload (first 1)]
  [
    {
      "user_msg": "เปิดเพลง",
      "response": "{\"name\": \"play_music\", \"parameters\": {}}"
    }
  ]
  
  [Output Instructions]
  1. ONLY rename keys; do NOT alter values.
  2. If a key already matches a canonical key, OMIT it from the mapping.
  3. If a key cannot be confidently mapped, OMIT it (rows with unmapped required keys will be dropped).
  4. Output ONLY a JSON object: {"field_mapping": {"old_key": "new_key", ...}}
  
  '''
