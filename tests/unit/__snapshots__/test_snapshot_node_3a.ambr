# name: test_detect_renames_keys_via_gemini
  dict({
    'fd_result': dict({
      'canonical_rows': list([
        dict({
          'label': 'billing',
          'text': 'I want a refund',
        }),
        dict({
          'label': 'technical',
          'text': 'App crashes on launch',
        }),
      ]),
      'field_mapping': dict({
        'answer': 'label',
        'text1': 'text',
      }),
      'notes': None,
      'ran': True,
      'rows_dropped': 0,
    }),
    'llm_call_count': 1,
    'llm_call_kwargs': dict({
      'max_tokens': 512,
      'model': 'google/gemini-2.5-flash-lite',
      'response_format': dict({
        'type': 'json_object',
      }),
      'system': 'You are a schema-mapping assistant. Given sample rows from a user-uploaded seed dataset and the canonical schema for a task, produce a JSON object that maps each non-canonical key in the samples to its canonical equivalent. Output ONLY a JSON object — no prose, no markdown, no explanation.',
      'temperature': 0.0,
      'user': '''
        [Task type] classification
        
        [Canonical schema]
        All keys: ['label', 'text']
        Required: ['label', 'text']
        
        [Sample rows from upload (first 2)]
        [
          {
            "text1": "I want a refund",
            "answer": "billing"
          },
          {
            "text1": "App crashes on launch",
            "answer": "technical"
          }
        ]
        
        [Output Instructions]
        1. ONLY rename keys; do NOT alter values.
        2. If a key already matches a canonical key, OMIT it from the mapping.
        3. If a key cannot be confidently mapped, OMIT it (rows with unmapped required keys will be dropped).
        4. Output ONLY a JSON object: {"field_mapping": {"old_key": "new_key", ...}}
  
      ''',
    }),
  })
