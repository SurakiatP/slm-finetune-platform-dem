# Base URL of the FastAPI backend. Leave empty in dev — the Vite proxy
# forwards /api and /ws to http://localhost:8000 (see vite.config.ts).
VITE_API_BASE=

# Supabase auth — required only when the backend runs AUTH_REQUIRED=true.
# Leave BOTH empty against a local dev backend (AUTH_REQUIRED=false): the
# app then runs without a login gate and sends no Authorization header.
# Set BOTH to target an authenticated deployment; the app gates behind an
# email/password login and attaches the session JWT to every /api call and
# to /ws via the ["bearer", <jwt>] subprotocol.
#
# The publishable (anon) key is public by design — it ships in the browser
# bundle regardless. NEVER put the service_role key or JWT secret here.
# Current production project (same one smart-model-tune uses):
#   VITE_SUPABASE_URL=https://mqoftavekwbsgpwzjdfb.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=<anon key — copy from smart-model-tune/docker-compose.yml>
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
