# Session-local working files — PR draft bodies, ad-hoc smoke drivers,
# screenshots used inside one conversation. Driver scripts that should
# stick around live under scripts/swagger_smoke_*.py instead.
scripts/session*_pr_body.md
scripts/session*_retry*.py
scripts/session*_retries.py
scripts/session*_runbook_driver.py
*.png
!docs/**/*.png

# Private documentation — kept local, not published to GitHub.
# EXCEPTION: docs/ holds the published backend handoff bundle — the files
# negated below ARE tracked/pushed (for the frontend/integration team).
# Uses `docs/*` (not `docs/`) so specific files can be re-included; anything
# in docs/ not listed here stays private by default.
docs/*
!docs/README.md
!docs/01-architecture.md
!docs/02-api-reference.md
!docs/03-realtime-websocket.md
!docs/04-frontend-integration-smart-model-tune.md
!docs/05-models-catalog.md
!docs/openapi.json
# Directories need the dir itself un-ignored before its contents — `docs/*`
# matches `docs/adr` and git won't descend into an excluded directory, so
# `!docs/adr/**` alone would silently keep every ADR out of the repo.
!docs/adr/
!docs/adr/**
!docs/runbooks/
!docs/runbooks/**
CLAUDE.md
API_GUIDE.md
PHASE9_SDG_HARDENING_SPEC.md
SWAGGER_GUIDE.md
TASK_TRACKER.md
WORKING_LOG.md
require.md
