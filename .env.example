# ============================================================
# SLM Fine-Tuning Platform — environment variables
# Copy to `.env` and fill in secrets. NEVER commit `.env`.
# ============================================================

# --- App ----------------------------------------------------
# dev | staging | production. Setting this to `production` turns on the
# credential checks in api/core/config.py: the app then REFUSES TO START
# while MINIO_ACCESS_KEY / MINIO_SECRET_KEY are still `minioadmin`, or while
# DATABASE_URL still carries the `slm:slm` pair below. Change those first,
# then flip this. Leave it as `dev` for local work — every value in this
# file is a known default and none of them belong on a public host.
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_PORT=8081
# Comma-separated origins for CORS (frontend dev servers). Keep this in
# sync with api/core/config.py's default if you add more origins there —
# setting this var REPLACES the code default rather than appending to it.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://gentle-fine-tuner.lovable.app

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=slm
POSTGRES_PASSWORD=slm
POSTGRES_DB=slm
POSTGRES_PORT=5432

# --- Redis (Celery broker + pub/sub) ------------------------
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) -------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATASETS_BUCKET=datasets
MINIO_MODELS_BUCKET=models
MLFLOW_S3_BUCKET=mlflow

# --- MLflow -------------------------------------------------
MLFLOW_PORT=5000

# --- OpenRouter (synthetic data generation) -----------------
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TEACHER_MODEL=qwen/qwen3-235b-a22b-2507
# Optional: HTTP referer / app title that OpenRouter requires for analytics.
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=slm-platform

# --- Fine-tuning defaults -----------------------------------
DEFAULT_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
# Maximum trial count for HPO mode (per-job override allowed).
DEFAULT_HPO_MAX_TRIALS=10

# --- Ollama -------------------------------------------------
OLLAMA_PORT=11434

# --- LLM Judge (evaluation, also via OpenRouter) ------------
# Confirmed working on OpenRouter as of 2026-05-10. The previous default
# `anthropic/claude-3.5-sonnet` was retired and now 404s.
LLM_JUDGE_MODEL=qwen/qwen3-235b-a22b-2507

# --- Job reconciliation (orphan sweep) -----------------------
# Minutes of silence before a pending/running job with no worker in
# Celery's active set is flipped to failed. Keep this comfortably above
# normal progress-publish cadence to avoid false positives.
JOB_ORPHAN_GRACE_MINUTES=15

# --- Auth (Supabase JWT, see api/core/auth.py) ---------------
# Project URL, e.g. https://<ref>.supabase.co — used both to derive the
# JWKS endpoint (f"{SUPABASE_URL}/auth/v1/.well-known/jwks.json") and as
# the expected `iss` claim on every token.
SUPABASE_URL=
# Expected `aud` claim. Supabase's default for authenticated end users.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional HS256 fallback secret — only needed for Supabase projects still
# on legacy symmetric signing keys. Leave blank on the JWKS (asymmetric)
# path, which is what this platform's frontend uses.
SUPABASE_JWT_SECRET=
# Phase-1 compatibility switch. false (default): tokens are verified when
# present but a missing Authorization header is still allowed (anonymous),
# so the current frontend keeps working until it sends the header. Flip to
# true once it does, to actually require authentication.
AUTH_REQUIRED=false
