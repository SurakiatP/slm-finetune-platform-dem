# ============================================================
# SLM Fine-Tuning Platform — environment variables
# Copy to `.env` and fill in secrets. NEVER commit `.env`.
# ============================================================

# --- App ----------------------------------------------------
LOG_LEVEL=INFO
API_PORT=8000
# Comma-separated origins for CORS (frontend dev servers).
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=slm
POSTGRES_PASSWORD=slm
POSTGRES_DB=slm
POSTGRES_PORT=5432

# --- Redis (Celery broker + pub/sub) ------------------------
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) -------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATASETS_BUCKET=datasets
MINIO_MODELS_BUCKET=models
MLFLOW_S3_BUCKET=mlflow

# --- MLflow -------------------------------------------------
MLFLOW_PORT=5000

# --- OpenRouter (synthetic data generation) -----------------
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TEACHER_MODEL=anthropic/claude-3.5-sonnet
# Optional: HTTP referer / app title that OpenRouter requires for analytics.
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=slm-platform

# --- Fine-tuning defaults -----------------------------------
DEFAULT_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
# Maximum trial count for HPO mode (per-job override allowed).
DEFAULT_HPO_MAX_TRIALS=10

# --- Ollama -------------------------------------------------
OLLAMA_PORT=11434

# --- LLM Judge (evaluation, also via OpenRouter) ------------
# Confirmed working on OpenRouter as of 2026-05-10. The previous default
# `anthropic/claude-3.5-sonnet` was retired and now 404s.
LLM_JUDGE_MODEL=google/gemini-3.1-flash-lite-preview
