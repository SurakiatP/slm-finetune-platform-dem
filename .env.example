# ============================================================
# SLM Fine-Tuning Platform — environment variables
# Copy to `.env` and fill in secrets. NEVER commit `.env`.
# ============================================================

# --- App ----------------------------------------------------
# dev | staging | production. Setting this to `production` turns on the
# guards in api/core/config.py: the app then REFUSES TO START while
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY are still `minioadmin`, while
# DATABASE_URL or ALEMBIC_DATABASE_URL still carry the `slm:slm` pair below,
# while AUTH_REQUIRED is still `false`, or while AUTH_REQUIRED=true has
# neither SUPABASE_URL nor SUPABASE_JWT_SECRET set. Change those first, then
# flip this. Leave it as `dev` for local work — every value in this file is
# a known default and none of them belong on a public host.
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Loopback-only host port for the API container. Since the edge became the
# sole ingress, nothing external reaches this — it is for `curl` from the VM
# and for `docker compose exec`-free debugging. The deploy script no longer
# reads it at all (it sanity-checks EDGE_PORT instead), so the old 8081-vs-8080
# drift between this file and the VM is gone rather than merely documented.
API_PORT=8081
# Comma-separated origins for CORS (frontend dev servers). Keep this in
# sync with api/core/config.py's default if you add more origins there —
# setting this var REPLACES the code default rather than appending to it.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://gentle-fine-tuner.lovable.app
# Comma-separated Host header allowlist for TrustedHostMiddleware. Blank/unset
# defaults to "*" (allow-all) in code — safe for local dev and for this
# repo's own unit suite, which only sets DATABASE_URL. A production value
# MUST include `localhost`, `127.0.0.1`, and `api`, or the deploy script's
# Phase 7 check (which curls `localhost:${EDGE_PORT}/health`) is rejected
# with 400 and the app looks down when it is actually the host guard doing
# its job. Note there is no compose `healthcheck:` on `api` or `edge` —
# only postgres/redis/minio/mlflow have one.
API_ALLOWED_HOSTS=

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=slm
POSTGRES_PASSWORD=slm
POSTGRES_DB=slm
POSTGRES_PORT=5432

# --- Redis (Celery broker + pub/sub) ------------------------
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) -------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATASETS_BUCKET=datasets
MINIO_MODELS_BUCKET=models
MLFLOW_S3_BUCKET=mlflow
# Browser-facing base URL for presigned downloads, e.g.
# https://storage.slmpc.pasaflow.com. Must be a dedicated subdomain with NO
# path component and NO explicit default port (:443 on https, :80 on http)
# — see the field_validator on Settings.minio_public_url in
# api/core/config.py for why both of those are hard-rejected at boot
# (SigV4 canonical-URI signing and host:port signature matching,
# respectively). Leave blank in dev; presigned links just won't be
# externally reachable, which is fine when nothing outside the compose
# network is trying to fetch them.
MINIO_PUBLIC_URL=
# Presigned GET URL lifetime in seconds. Bounded 60-604800 (1 min-7 days) —
# minio-py's presign_v4 hard-rejects anything outside that range.
PRESIGNED_URL_TTL_SECONDS=300

# --- MLflow -------------------------------------------------
MLFLOW_PORT=5000

# --- OpenRouter (synthetic data generation) -----------------
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TEACHER_MODEL=qwen/qwen3-235b-a22b-2507
# Optional: HTTP referer / app title that OpenRouter requires for analytics.
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=slm-platform

# --- Fine-tuning defaults -----------------------------------
DEFAULT_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
# Maximum trial count for HPO mode (per-job override allowed).
DEFAULT_HPO_MAX_TRIALS=10

# --- GPU VRAM safety ------------------------------------------
# See api/core/config.py and workers/vram.py. Training/HPO/export tasks
# check free VRAM before doing any GPU work, so a card that's still busy
# with a previous job fails fast with an actionable message instead of an
# opaque CUDA OOM traceback minutes into the run.
# Total VRAM of the target card — cosmetic (renders in the failure
# message), not itself a threshold.
GPU_VRAM_TOTAL_GB=12.0
# Minimum free VRAM (GiB) required to start a GPU task. Below this, the
# task fails immediately with a preflight error instead of OOMing mid-run.
GPU_PREFLIGHT_MIN_FREE_GB=8.0
# Kill switch for the preflight check itself; leave true unless debugging
# a false positive (e.g. a driver misreporting free memory).
GPU_PREFLIGHT_ENFORCE=true

# --- Ollama -------------------------------------------------
OLLAMA_PORT=11434

# --- Observability (Prometheus + GPU exporter) ---------------
# Loopback-only host ports, same rationale as every other port in this file.
# `gpu-exporter` is expected to stay down on the pasaflow prod box until a
# host nvidia driver bug there is fixed (see docker-compose.yml's
# `gpu-exporter` comment) — Prometheus still starts fine either way.
PROMETHEUS_PORT=9090
GPU_EXPORTER_PORT=9835

# --- LLM Judge (evaluation, also via OpenRouter) ------------
# Confirmed working on OpenRouter as of 2026-05-10. The previous default
# `anthropic/claude-3.5-sonnet` was retired and now 404s.
LLM_JUDGE_MODEL=qwen/qwen3-235b-a22b-2507

# --- Job reconciliation (orphan sweep) -----------------------
# Minutes of silence before a pending/running job with no worker in
# Celery's active set is flipped to failed. Keep this comfortably above
# normal progress-publish cadence to avoid false positives.
JOB_ORPHAN_GRACE_MINUTES=15

# --- Auth (Supabase JWT, see api/core/auth.py) ---------------
# Project URL, e.g. https://<ref>.supabase.co — used both to derive the
# JWKS endpoint (f"{SUPABASE_URL}/auth/v1/.well-known/jwks.json") and as
# the expected `iss` claim on every token.
SUPABASE_URL=
# Expected `aud` claim. Supabase's default for authenticated end users.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional HS256 fallback secret — only needed for Supabase projects still
# on legacy symmetric signing keys. Leave blank on the JWKS (asymmetric)
# path, which is what this platform's frontend uses.
SUPABASE_JWT_SECRET=
# Phase-1 compatibility switch. false (default): tokens are verified when
# present but a missing Authorization header is still allowed (anonymous),
# so the current frontend keeps working until it sends the header. Flip to
# true once it does, to actually require authentication.
AUTH_REQUIRED=false

# --- SDG semantic dedup (embeddings via OpenRouter) ----------
# Embedding model used for the post-MinHash semantic dedup pass.
# Leave EMPTY to disable the semantic layer (MinHash-only dedup).
# $0.02 / 1M input tokens; embeddings bill prompt tokens only.
SDG_EMBEDDING_MODEL=openai/text-embedding-3-small
# Cosine similarity at/above which two rows count as semantic duplicates.
SDG_EMBEDDING_DEDUP_THRESHOLD=0.90

# --- Model pricing (see api/services/model_pricing.py) -------
# JSON object {model_id: {"prompt": usd_per_1m, "completion": usd_per_1m}}
# overriding/extending the built-in price map. Leave blank to use only the
# built-in defaults.
MODEL_PRICING_JSON=

# --- Concurrency quotas (see api/services/quota.py) -----------
# Per-actor caps apply to authenticated callers only (see api/core/config.py);
# under today's AUTH_REQUIRED=false only the global caps below are enforced.
QUOTA_MAX_GPU_JOBS_PER_ACTOR=1
QUOTA_MAX_SDG_JOBS_PER_ACTOR=2
QUOTA_MAX_GPU_JOBS_GLOBAL=4
QUOTA_MAX_SDG_JOBS_GLOBAL=8
# Seconds a quota-rejected request's Retry-After header advises waiting.
QUOTA_RETRY_AFTER_SECONDS=30

# --- OpenRouter circuit breaker (see api/services/circuit_breaker.py) --
OPENROUTER_BREAKER_FAILURE_THRESHOLD=5
OPENROUTER_BREAKER_OPEN_SECONDS=60

# --- Monthly OpenRouter budget ---------------------------------
# Calendar-month window (matches OpenRouter's own billing period). Blank
# means unlimited — the feature ships dark until you set a real number.
BUDGET_MONTHLY_USD_PER_ACTOR=
BUDGET_MONTHLY_USD_GLOBAL=

# --- Edge ingress: nginx + Cloudflare Tunnel ------------------------
# EDGE_PORT: loopback-only host port for the `edge` nginx. Nothing is
# published on 0.0.0.0 any more — cloudflared reaches edge over the compose
# network — so this exists purely for local debugging and `curl` from the VM.
EDGE_PORT=8088
# SPA_DIST_DIR: host directory whose contents the edge serves at `/`. Point
# it at whichever frontend's built `dist/`; the default is a placeholder page
# so the stack boots before that decision is made.
SPA_DIST_DIR=./docker/spa-placeholder
#
# CLOUDFLARE_TUNNEL_ID is REQUIRED to deploy, and the deploy script's
# Phase 4.6 pre-flight refuses to continue without it. Compose uses `:-`,
# NOT `:?`: compose interpolates the whole file before selecting services,
# and treats `:?` as an error on an empty value too — so a `:?` here would
# break `docker compose up/build/config/ps` for anyone who just ran
# `cp .env.example .env`. It is deliberately NOT written into
# docker/cloudflared/config.yml — compose does not interpolate the contents
# of bind-mounted files, so a placeholder there would reach cloudflared as a
# literal string and the tunnel would never start.
# CLOUDFLARE_TUNNEL_ID: the tunnel UUID from `cloudflared tunnel create`.
# CLOUDFLARE_TUNNEL_CREDS_DIR: host directory holding that tunnel's
# credentials JSON, bind-mounted read-only into the cloudflared container.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDS_DIR=
